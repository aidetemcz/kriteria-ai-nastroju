# Anthropic API klic (na Vercelu nastav jako Environment Variable, nikdy do gitu)
ANTHROPIC_API_KEY=sk-ant-...

# --- Ladeni kvality vs. nakladu (vse volitelne) ---

# Model. Vychozi claude-opus-5 = nejlepsi kvalita posouzeni.
# Levnejsi a plne kompatibilni alternativa: claude-sonnet-5
# POZOR: claude-haiku-4-5 NEfunguje bez uprav kodu (jina konfigurace uvazovani
# a starsi verze nastroje vyhledavani).
ANTHROPIC_MODEL=claude-sonnet-5

# Hloubka uvazovani: low | medium | high | xhigh | max. Vychozi high.
# medium znatelne snizi cenu i cekani, posouzeni je melci.
ANTHROPIC_EFFORT=high

# Maximalni pocet vyhledavani na webu v jedne odpovedi (1-30). Vychozi 12.
# Vyhledavani se uctuje zvlast, takze je to druha paka na naklady.
ANTHROPIC_MAX_SEARCHES=12

# --- Pripominky ---

# URL Google Apps Script web app pro sber pripominek
# (viz docs/pripominky-apps-script.md). Bez teto promenne formular vraci chybu.
FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
