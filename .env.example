# Anthropic API klic (na Vercelu nastav jako Environment Variable, nikdy do gitu)
ANTHROPIC_API_KEY=sk-ant-...

# Volitelne: prepnuti modelu. Vychozi je claude-opus-5.
# Levnejsi varianta pro provoz s vetsim objemem dotazu: claude-sonnet-5
ANTHROPIC_MODEL=claude-opus-5

# Volitelne: URL Google Apps Script web app pro sber pripominek
# (viz docs/pripominky-apps-script.md). Bez teto promenne je formular pripominek vypnuty.
FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
